# Z.ai API key (required). Get one at https://z.ai
ZAI_KEY=your-zai-api-key-here

# Z.ai chat-completions endpoint and model.
# Model must be the hyphenated glm-5.3-flash (glm5.3-flash returns error 1211).
ZAI_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_MODEL=glm-5.3-flash

# Chrome DevTools Protocol port the script attaches to.
CDP_PORT=9222

# Persistent Chrome profile used when the script has to launch Chrome itself.
# Keeps your SpeedExam login/cookies between runs.
PROFILE_DIR=~/.examcheat-chrome-profile

# Chrome binary.
CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Poll interval for the exam page, and HUD panel size in points.
POLL_SECONDS=1.0
PANEL_W=340
PANEL_H=64
